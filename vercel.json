{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!uploads|assets|css|js|images|.*\\.).*)",
      "destination": "/api/index.php"
    },
    {
      "source": "/(.*\\.php)",
      "destination": "/api/index.php"
    }
  ]
}
